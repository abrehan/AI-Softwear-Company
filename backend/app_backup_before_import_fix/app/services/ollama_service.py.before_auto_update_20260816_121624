import os

import httpx


class OllamaService:

    def __init__(self):
        self.base_url = os.getenv(
            "OLLAMA_BASE_URL",
            "http://127.0.0.1:11434",
        ).rstrip("/")

        self.connect_timeout = float(
            os.getenv("OLLAMA_CONNECT_TIMEOUT", "10")
        )

        self.read_timeout = float(
            os.getenv("OLLAMA_READ_TIMEOUT", "120")
        )

        self.write_timeout = float(
            os.getenv("OLLAMA_WRITE_TIMEOUT", "30")
        )

        self.pool_timeout = float(
            os.getenv("OLLAMA_POOL_TIMEOUT", "10")
        )

        self.num_predict = int(
            os.getenv("OLLAMA_NUM_PREDICT", "1200")
        )

        self.num_ctx = int(
            os.getenv("OLLAMA_NUM_CTX", "8192")
        )

    async def generate(self, prompt: str, model: str):

        print(f"[OLLAMA] URL: {self.base_url}")
        print(f"[OLLAMA] Using model: {model}")
        print(
            f"[OLLAMA] Prompt length: "
            f"{len(prompt):,} characters"
        )
        print(
            f"[OLLAMA] Max output tokens: "
            f"{self.num_predict}"
        )
        print(
            f"[OLLAMA] Context window: "
            f"{self.num_ctx}"
        )
        print(
            f"[OLLAMA] Read timeout: "
            f"{self.read_timeout:g}s"
        )

        timeout = httpx.Timeout(
            connect=self.connect_timeout,
            read=self.read_timeout,
            write=self.write_timeout,
            pool=self.pool_timeout,
        )

        try:
            async with httpx.AsyncClient(
                timeout=timeout
            ) as client:

                response = await client.post(
                    f"{self.base_url}/api/generate",
                    json={
                        "model": model,
                        "prompt": prompt,
                        "stream": False,
                        "options": {
                            "num_predict": self.num_predict,
                            "num_ctx": self.num_ctx,
                        },
                    },
                )

                response.raise_for_status()

                data = response.json()

                result = data.get("response", "")

                print(
                    "[OLLAMA] Response received "
                    f"({len(result):,} characters)."
                )

                if not result.strip():
                    print(
                        "[OLLAMA] WARNING: "
                        "Empty response received."
                    )

                return result

        except httpx.ConnectTimeout:
            return "Ollama connection timed out."

        except httpx.ReadTimeout:
            return (
                "Ollama generation exceeded "
                f"{self.read_timeout:g} seconds."
            )

        except httpx.ConnectError:
            return (
                "Ollama is unavailable from this deployment. "
                "The configured Ollama endpoint is not reachable."
            )

        except httpx.HTTPStatusError as e:
            return (
                "Ollama HTTP Error "
                f"{e.response.status_code}: "
                f"{e.response.text[:500]}"
            )

        except Exception as e:
            return (
                "Unexpected Ollama Error: "
                f"{str(e)}"
            )
